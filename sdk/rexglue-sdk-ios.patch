+/// A PPC function almost always opens by saving the link register or pushing a
+/// frame. Requiring one of those patterns keeps random data that happens to look
+/// like a code address from being registered as a function.
+bool LooksLikeFunctionStart(const rex::codegen::BinaryView& bv, uint32_t addr) {
+  for (const auto& sec : bv.sections()) {
+    if (!sec.executable || !sec.contains(addr) || addr + 8 > sec.end()) {
+      continue;
+    }
+    const uint8_t* p = sec.translate(addr);
+    auto be32 = [](const uint8_t* q) {
+      return (uint32_t(q[0]) << 24) | (uint32_t(q[1]) << 16) | (uint32_t(q[2]) << 8) | uint32_t(q[3]);
+    };
+    const uint32_t i0 = be32(p);
+    const uint32_t i1 = be32(p + 4);
+    auto is_mflr = [](uint32_t i) { return (i & 0xFC1FFFFE) == 0x7C0802A6; };   // mfspr rX, LR
+    auto is_stwu_r1 = [](uint32_t i) { return (i & 0xFFFF0000) == 0x94210000; }; // stwu r1, d(r1)
+    auto is_stw_r1 = [](uint32_t i) { return (i & 0xFC1F0000) == 0x90010000; };  // stw rX, d(r1)
+    auto is_std_r1 = [](uint32_t i) { return (i & 0xFC1F0003) == 0xF8010000; };  // std rX, d(r1)
+    return is_mflr(i0) || is_stwu_r1(i0) || is_stw_r1(i0) || is_std_r1(i0) ||
+           is_mflr(i1) || is_stwu_r1(i1);
+  }
+  return false;
+}
+
+void ScanCodePointers(const rex::codegen::BinaryView& bv, const std::string& out_path) {
+  std::set<uint32_t> hits;
+  size_t scanned = 0;
+  for (const auto& sec : bv.sections()) {
+    if (sec.executable) {
+      continue;  // only data sections hold vtables and callback tables
+    }
+    for (uint32_t off = 0; off + 4 <= sec.size; off += 4) {
+      const uint8_t* q = sec.data + off;
+      const uint32_t value = (uint32_t(q[0]) << 24) | (uint32_t(q[1]) << 16) |
+                             (uint32_t(q[2]) << 8) | uint32_t(q[3]);
+      ++scanned;
+      if (value & 3) {
+        continue;  // PPC instructions are 4-byte aligned
+      }
+      if (!bv.isExecutable(value)) {
+        continue;
+      }
+      if (LooksLikeFunctionStart(bv, value)) {
+        hits.insert(value);
+      }
+    }
+  }
+  std::ofstream out(out_path);
+  out << "# Generated by rexglue --scan_code_pointers_to\n";
+  out << "# " << hits.size() << " candidate function pointers from " << scanned
+      << " scanned data words.\n";
+  out << "# These are addresses stored in data that point at a function prologue in\n";
+  out << "# .text: vtable slots and callback tables with no RTTI for VTableScanner to\n";
+  out << "# follow. Merge into [entrypoint.functions].\n";
+  for (uint32_t a : hits) {
+    out << fmt::format("0x{:08X} = {{ name = \"sub_{:08X}\" }}\n", a, a);
+  }
+  REXCODEGEN_INFO("Code-pointer scan: {} candidates written to {}", hits.size(), out_path);
+}
