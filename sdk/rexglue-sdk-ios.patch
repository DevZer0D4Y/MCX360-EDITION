+      ImGui::ProgressBar(fraction, ImVec2(-1.0f, 0.0f));
+      ImGui::Separator();
+      ImGui::BeginChild("achievement_list", ImVec2(0.0f, -34.0f), false);
+      bool drew_locked_header = false;
+      for (const Entry& entry : entries_) {
