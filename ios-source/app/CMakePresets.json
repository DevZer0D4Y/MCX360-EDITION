{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "ios-arm64-release",
            "displayName": "iOS arm64 Release (device)",
            "description": "Requires the REXGLUE_SDK environment variable: the patched rexglue-sdk checkout, built for macOS (host tools) and iOS.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_SYSROOT": "iphoneos",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
                "CMAKE_PREFIX_PATH": "$env{REXGLUE_SDK}/out/install/ios-arm64",
                "rexglue_DIR": "$env{REXGLUE_SDK}/out/install/ios-arm64/lib/cmake/rexglue",
                "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "BOTH",
                "REXGLUE_HOST_TOOL": "$env{REXGLUE_SDK}/out/mac-arm64/Release/rexglue",
                "MC360_IOS_SDK_LIB_DIR": "$env{REXGLUE_SDK}/out/ios-arm64/Release"
            },
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        }
    ],
    "buildPresets": [
        { "name": "ios-arm64-release", "configurePreset": "ios-arm64-release" }
    ]
}
